/* =========================================================
   GLOBAL
   ========================================================= */

QMainWindow {
    background-color: #F4EFE6;
    color: #2C2C2C;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel {
    color: #2C2C2C;
}


/* =========================================================
   MAIN INPUTS
   ========================================================= */

QLineEdit,
QComboBox,
QSpinBox,
QDateEdit {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 10px;

    padding: 7px 34px 7px 10px;
    min-height: 24px;
}

QLineEdit {
    padding: 8px 12px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus {
    border: 2px solid #52796F;
}

QLineEdit::placeholder {
    color: #777777;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border: none;
    border-radius: 10px;

    padding: 8px 16px;

    font-weight: bold;
}

QPushButton:hover {
    background-color: #354F52;
}

QPushButton:pressed {
    background-color: #2F3E46;
}

QPushButton:disabled {
    background-color: #AEB8B2;
    color: #EEEEEE;
}


/* =========================================================
   COMBOBOX / DATEEDIT DROPDOWN
   ========================================================= */

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    width: 30px;

    border: none;
    background: transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(assets/down_arrow.svg);

    width: 12px;
    height: 8px;
}


/* =========================================================
   COMBOBOX POPUP
   ========================================================= */

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 1px solid #CAD2C5;
    border-radius: 8px;

    padding: 4px;

    outline: none;

    selection-background-color: #84A98C;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E4EBDD;
    color: #2C2C2C;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #84A98C;
    color: #FFFFFF;
}


/* =========================================================
   SPINBOX ARROWS
   ========================================================= */

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;

    width: 28px;

    border: none;
    background: transparent;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;

    width: 28px;

    border: none;
    background: transparent;
}

QSpinBox::up-arrow {
    image: url(assets/up_arrow.svg);

    width: 12px;
    height: 8px;
}

QSpinBox::down-arrow {
    image: url(assets/down_arrow.svg);

    width: 12px;
    height: 8px;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

QTreeWidget {
    background-color: #2F3E46;
    color: #F8F5F0;

    border: none;

    padding: 12px;
}

QTreeWidget::item {
    color: #F8F5F0;

    padding: 10px;

    border-radius: 8px;
}

QTreeWidget::item:hover {
    background-color: #354F52;
}

QTreeWidget::item:selected {
    background-color: #C9A227;
    color: #1B1B1B;
}


/* =========================================================
   BOOK GRID
   ========================================================= */

#booksArea {
    background-color: #D1D2B8;
}


/* =========================================================
   BOOK CARDS
   ========================================================= */

QFrame#bookCard {
    border-radius: 12px;
    padding: 12px;
    margin: 8px;
}

QFrame#bookCard[status="want_to_read"] {
    background-color: #F3D6D6;
    border: 1px solid #DFB5B5;
}

QFrame#bookCard[status="currently_reading"] {
    background-color: #F3E3C3;
    border: 1px solid #DFCC9E;
}

QFrame#bookCard[status="finished"] {
    background-color: #D8EAD9;
    border: 1px solid #B8D5BB;
}

QFrame#bookCard:hover {
    border: 2px solid #C9A227;
}

QFrame#bookCard QLabel {
    background-color: transparent;
}

QLabel#bookTitle {
    color: #2C2C2C;

    font-size: 18px;
    font-weight: bold;
}


/* =========================================================
   ADD / EDIT BOOK DIALOG
   ========================================================= */

#addBookDialog {
    background-color: #E8F1E3;
}

#addBookDialog QLabel {
    color: #2F3E46;

    font-size: 14px;
    font-weight: bold;
}

#addBookDialog QLineEdit,
#addBookDialog QComboBox,
#addBookDialog QSpinBox,
#addBookDialog QDateEdit {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 12px;

    padding: 8px 34px 8px 12px;
}

#addBookDialog QLineEdit:focus,
#addBookDialog QComboBox:focus,
#addBookDialog QSpinBox:focus,
#addBookDialog QDateEdit:focus {
    border: 2px solid #52796F;
}

#addBookDialog QTextEdit {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 12px;

    padding: 10px;
}

#addBookDialog QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border-radius: 12px;

    padding: 10px 20px;

    font-weight: bold;
}

#addBookDialog QPushButton:hover {
    background-color: #354F52;
}

#addBookDialog QCheckBox {
    color: #000000;
    font-size: 14px;
}

#addBookDialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
}


/* =========================================================
   BOOK DETAILS
   ========================================================= */

#bookDetails[status="want_to_read"] {
    background-color: #F3D6D6;
}

#bookDetails[status="currently_reading"] {
    background-color: #F3E3C3;
}

#bookDetails[status="finished"] {
    background-color: #D8EAD9;
}

#detailsTitle {
    color: #2F3E46;

    font-size: 24px;
    font-weight: bold;
}

#sectionTitle {
    color: #2F3E46;

    font-size: 16px;
    font-weight: bold;
}

#bookDetails QTextEdit {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 12px;

    padding: 10px;
}

#bookDetails QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border-radius: 10px;

    padding: 8px 18px;

    font-weight: bold;
}

#bookDetails QPushButton:hover {
    background-color: #354F52;
}


/* =========================================================
   STATISTICS PAGE
   ========================================================= */

#statisticsPage,
#statisticsScrollContent {
    background-color: #E4EBDD;
}

#statisticsPage QScrollArea {
    background-color: #E4EBDD;
    border: none;
}

#statisticsTitle {
    color: #2F3E46;

    font-size: 28px;
    font-weight: bold;
}

#statCard {
    background-color: #F7FAF5;

    border: 1px solid #CAD2C5;
    border-radius: 16px;

    min-height: 110px;
}

#statValue {
    color: #52796F;

    font-size: 28px;
    font-weight: bold;
}

#statLabel {
    color: #555555;
    font-size: 14px;
}

#statisticsSection {
    background-color: #F7FAF5;

    border: 1px solid #CAD2C5;
    border-radius: 16px;

    padding: 10px;
}

#statisticsSectionTitle {
    color: #354F52;

    font-size: 18px;
    font-weight: bold;

    margin-bottom: 8px;
}

#statisticsPage QProgressBar {
    background-color: #D8E2DC;

    border: none;
    border-radius: 8px;

    height: 22px;

    text-align: center;
}

#statisticsPage QProgressBar::chunk {
    background-color: #84A98C;
    border-radius: 8px;
}

#highlightLabel {
    color: #52796F;

    font-weight: bold;

    min-width: 150px;
}


/* =========================================================
   SUGGESTIONS PAGE
   ========================================================= */

#suggestionPage {
    background-color: #E4EBDD;
}

#suggestionTitle {
    color: #2F3E46;

    font-size: 28px;
    font-weight: bold;
}

#suggestionMessage {
    color: #52796F;
    font-size: 14px;
}

#suggestionResults {
    background-color: transparent;
    border: none;
}

#suggestionPage QListWidget {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 10px;

    padding: 6px;
}

#suggestionPage QListWidget::item {
    color: #2C2C2C;

    padding: 5px;

    border-radius: 5px;
}

#suggestionPage QListWidget::item:hover {
    background-color: #E4EBDD;
}

#suggestionPage QListWidget::item:selected {
    background-color: #CAD2C5;
    color: #2C2C2C;
}


/* =========================================================
   CALENDAR
   ========================================================= */

QCalendarWidget#dateCalendar {
    background-color: #F7FAF5;
    color: #2C2C2C;
}

QCalendarWidget#dateCalendar QWidget {
    background-color: #F7FAF5;
    color: #2C2C2C;
}

QCalendarWidget#dateCalendar QWidget#qt_calendar_navigationbar {
    background-color: #52796F;
    border-radius: 8px;
}

QCalendarWidget#dateCalendar QToolButton {
    background-color: transparent;
    color: #FFFFFF;

    border: none;
    border-radius: 6px;

    padding: 6px;

    font-weight: bold;
}

QCalendarWidget#dateCalendar QToolButton:hover {
    background-color: #354F52;
}

QCalendarWidget#dateCalendar QMenu {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 1px solid #CAD2C5;
}

QCalendarWidget#dateCalendar QAbstractItemView {
    background-color: #FFFFFF;
    color: #2C2C2C;

    selection-background-color: #84A98C;
    selection-color: #FFFFFF;

    border: none;
    outline: none;
}

QCalendarWidget#dateCalendar QSpinBox {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 1px solid #CAD2C5;
    border-radius: 5px;
}

/* =========================================================
   BACKUP MESSAGE
   ========================================================= */

#backupSuccessMessage {
    background-color: #F4F1DE;
}

#backupSuccessMessage QLabel {
    color: #2F3E46;

    font-size: 14px;
}

#backupSuccessMessage QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border: none;
    border-radius: 8px;

    padding: 7px 22px;

    font-weight: bold;

    min-width: 70px;
}

#backupSuccessMessage QPushButton:hover {
    background-color: #3F665E;
}

/* =========================================================
   RESTORE CONFIRMATION
   ========================================================= */

#restoreConfirmMessage {
    background-color: #F4F1DE;
}

#restoreConfirmMessage QLabel {
    color: #2F3E46;

    font-size: 14px;
}

#restoreConfirmMessage QPushButton {
    background-color: #CAD2C5;
    color: #2F3E46;

    border: none;
    border-radius: 8px;

    padding: 7px 22px;

    font-weight: bold;

    min-width: 70px;
}

#restoreConfirmMessage QPushButton:hover {
    background-color: #B8C4B3;
}


/* =========================================================
   BOOK LOOKUP DIALOG
   ========================================================= */

#bookLookupDialog {
    background-color: #F4F1DE;
}

#lookupTitle {
    color: #2F3E46;

    font-size: 20px;
    font-weight: bold;

    padding: 8px 4px;
}


/* =========================================================
   LOOKUP RESULTS
   ========================================================= */

#lookupResults {
    background-color: #FFFFFF;
    color: #2C2C2C;

    border: 2px solid #CAD2C5;
    border-radius: 12px;

    padding: 6px;

    font-size: 14px;
}

#lookupResults::item {
    border-bottom: 1px solid #E0E0E0;

    padding: 12px;

    min-height: 55px;
}

#lookupResults::item:selected {
    background-color: #D8EAD9;
    color: #2F3E46;

    border-radius: 8px;
}

#lookupResults::item:hover {
    background-color: #EEF4ED;
}


/* =========================================================
   LOOKUP BUTTON
   ========================================================= */

#bookLookupDialog QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border: none;
    border-radius: 10px;

    padding: 9px 18px;

    font-size: 14px;
    font-weight: bold;
}

#bookLookupDialog QPushButton:hover {
    background-color: #3F665E;
}

#bookLookupDialog QPushButton:pressed {
    background-color: #354F52;
}


/* =========================================================
   COVER LOOKUP DIALOG
   ========================================================= */

#coverLookupDialog {
    background-color: #F4F1DE;
}

#coverLookupTitle {
    color: #2F3E46;

    font-size: 20px;
    font-weight: bold;

    padding: 8px 4px;
}


/* =========================================================
   COVER RESULTS
   ========================================================= */

#coverLookupResults {
    background-color: #FFFFFF;

    border: 2px solid #CAD2C5;
    border-radius: 12px;

    padding: 8px;
}

#coverLookupResults::item {
    background-color: #FFFFFF;

    border: 2px solid transparent;
    border-radius: 10px;

    padding: 8px;

    margin: 4px;
}

#coverLookupResults::item:hover {
    background-color: #EEF4ED;
}

#coverLookupResults::item:selected {
    background-color: #D8EAD9;

    border: 2px solid #52796F;

    color: #2F3E46;
}


/* =========================================================
   COVER LOOKUP BUTTONS
   ========================================================= */

#coverLookupDialog QPushButton {
    background-color: #52796F;
    color: #FFFFFF;

    border: none;
    border-radius: 10px;

    padding: 9px 18px;

    font-size: 14px;
    font-weight: bold;

    min-height: 20px;
}

#coverLookupDialog QPushButton:hover {
    background-color: #3F665E;
}

#coverLookupDialog QPushButton:pressed {
    background-color: #354F52;
}


/* No Cover is intentionally less prominent */

#noCoverButton {
    background-color: #CAD2C5;
    color: #2F3E46;
}

#noCoverButton:hover {
    background-color: #B8C4B3;
}